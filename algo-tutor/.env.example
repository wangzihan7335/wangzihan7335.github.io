# 服务端代理配置（可选）
#
# 公开部署推荐使用 A 方案：访客在模型设置里填自己的 API Key。
# 此时请把 AI_API_KEY 留空，API Key 只保存在各自浏览器中。
#
# 如果只给自己/小范围使用，也可以在服务端填写 Key，并在模型设置里留空；
# 前端发送的 Key 永远优先。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 后端端口与监听地址
# 本地开发保持 127.0.0.1；Render/Railway/Docker 等平台请设为 0.0.0.0
PORT=8787
HOST=127.0.0.1

# 公开部署防护
# 每个 IP 每分钟最多允许的 POST /api 请求数（0 表示关闭限流）
RATE_LIMIT_PER_MINUTE=30
# 如果服务部署在 Render/Railway 等反向代理后面，设为 1 以读取 X-Forwarded-For
TRUST_PROXY=0
# 推荐在白名单中列出允许访问的模型域名；不设置则允许任何公网 HTTPS 地址
# ALLOWED_API_HOSTS=api.deepseek.com,api.moonshot.cn,api.openai.com,dashscope.aliyuncs.com
# 仅本地调试自建模型时可设为 1，允许 http/本机/内网地址；公网部署务必保持 0
ALLOW_PRIVATE_UPSTREAMS=0
